<div class="nh-jr-editor-body">
  <div class="nh-jr-editor-scroll">
    <div class="nh-jr-edit-grid">
      <label><span>{{localize "NEONHUB.Journal.Profile.Handle"}}</span><input type="text" name="handle" value="{{handle}}" maxlength="80"></label>
      <label><span>{{localize "NEONHUB.Journal.Profile.Origin"}}</span><input type="text" name="origin" value="{{origin}}" maxlength="200" placeholder="{{localize 'NEONHUB.Journal.Profile.OriginHint'}}"></label>
    </div>
    <section class="nh-jr-edit-block">
      <span class="nh-cal-kicker">// {{localize "NEONHUB.Journal.Profile.Goals"}}</span>
      <ol class="nh-jr-edit-rows">
        {{#each goals}}
        <li data-row="{{id}}">
          <input type="hidden" name="goals.{{i}}.id" value="{{id}}">
          <label class="nh-check" data-tooltip="{{localize 'NEONHUB.Journal.Profile.Done'}}"><input type="checkbox" name="goals.{{i}}.done" {{#if done}}checked{{/if}}></label>
          <input type="text" name="goals.{{i}}.text" value="{{text}}" maxlength="300" placeholder="{{localize 'NEONHUB.Journal.Profile.GoalHint'}}">
          <button type="button" class="nh-cal-icon" data-action="removeRow" data-list="goals" aria-label="{{localize 'NEONHUB.Journal.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
        </li>
        {{/each}}
      </ol>
      <button type="button" class="nh-cal-btn" data-action="addRow" data-list="goals"><i class="fa-solid fa-plus"></i> {{localize "NEONHUB.Journal.Profile.AddGoal"}}</button>
    </section>
    <section class="nh-jr-edit-block">
      <span class="nh-cal-kicker">// {{localize "NEONHUB.Journal.Profile.Contacts"}}</span>
      <ol class="nh-jr-edit-rows">
        {{#each contacts}}
        <li data-row="{{id}}">
          <input type="hidden" name="contacts.{{i}}.id" value="{{id}}">
          <input type="text" name="contacts.{{i}}.name" value="{{name}}" maxlength="120" class="nh-jr-fact-label" placeholder="{{localize 'NEONHUB.Journal.Profile.ContactName'}}">
          <input type="text" name="contacts.{{i}}.note" value="{{note}}" maxlength="300" placeholder="{{localize 'NEONHUB.Journal.Profile.ContactNote'}}">
          <button type="button" class="nh-cal-icon" data-action="removeRow" data-list="contacts" aria-label="{{localize 'NEONHUB.Journal.Remove'}}"><i class="fa-solid fa-xmark"></i></button>
        </li>
        {{/each}}
      </ol>
      <button type="button" class="nh-cal-btn" data-action="addRow" data-list="contacts"><i class="fa-solid fa-plus"></i> {{localize "NEONHUB.Journal.Profile.AddContact"}}</button>
    </section>
    <section class="nh-jr-edit-block">
      <span class="nh-cal-kicker">// {{localize "NEONHUB.Journal.Profile.Notes"}}</span>
      <div class="nh-jr-rich"></div>
    </section>
  </div>
  <footer class="nh-jr-edit-foot">
    <button type="button" class="nh-cal-btn" data-action="cancel">{{localize "NEONHUB.Journal.Cancel"}}</button>
    <button type="submit" class="nh-cal-btn nh-cal-btn-primary"><i class="fa-solid fa-floppy-disk"></i> {{localize "NEONHUB.Journal.Save"}}</button>
  </footer>
</div>
