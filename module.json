{
  "id": "cpr-neon-hub",
  "title": "Neon Hub: Landing Pages, Headquarters, Lifestyle & Calendar for Cyberpunk RED",
  "description": "Build clickable landing-page hub scenes with Monk's Active Tile Triggers, run crew Headquarters from the No Place Like Home rules, track each character's rent, lifestyle and monthly expenses, and keep group calendars with rent days and the real Moon, for the Cyberpunk RED - CORE system.",
  "version": "1.3.0",
  "authors": [
    {
      "name": "Neon Hub contributors"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "12"
  },
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": {
          "minimum": "0.92",
          "verified": "0.92.4"
        }
      }
    ],
    "requires": [
      {
        "id": "monks-active-tiles",
        "type": "module",
        "compatibility": {
          "minimum": "12.02"
        }
      }
    ],
    "recommends": [
      {
        "id": "cpr-neon-market",
        "type": "module",
        "reason": "Lets hub buttons open Neon Market shops."
      },
      {
        "id": "night-city-messenger",
        "type": "module",
        "reason": "Lets hub buttons open the Agent inbox, contacts and the messenger's GM tools."
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/neon-hub.css",
    "styles/calendar.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "lifestyle",
      "label": "Neon Hub: Lifestyle",
      "path": "packs/lifestyle",
      "type": "Item",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "street-goods",
      "label": "Neon Hub: Street Goods & Lifepath",
      "path": "packs/street-goods",
      "type": "Item",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Neon Hub",
      "sorting": "m",
      "color": "#ff2a6d",
      "packs": [
        "lifestyle",
        "street-goods"
      ]
    }
  ],
  "socket": true,
  "url": "",
  "manifest": "",
  "download": "",
  "license": "MIT",
  "readme": "README.md",
  "changelog": "CHANGELOG.md"
}
