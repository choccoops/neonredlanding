<div class="nh-cal-card" style="--cal: {{color}}">
  <div class="nh-cal-card-kicker">// {{localize "NEONHUB.Calendar.Chat.Kicker"}}</div>
  <div class="nh-cal-card-name">{{name}}</div>
  <div class="nh-cal-card-date">
    <span class="nh-cal-card-day">{{day}}</span>
    <span class="nh-cal-card-rest">
      <span>{{month}} {{year}}</span>
      <small>{{weekday}} · {{code}}</small>
    </span>
  </div>
  <div class="nh-cal-card-rent"><i class="fa-solid fa-house-chimney"></i> {{rent}}</div>
</div>
