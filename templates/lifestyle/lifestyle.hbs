<div class="nh-hq nh-ls {{themeClass}} {{#if busy}}is-busy{{/if}}" style="{{style}}">
  <header class="nh-hq-header">
    <div class="nh-hq-art" {{#if actor}}data-action="openSheet" data-tooltip="{{localize 'NEONHUB.Lifestyle.OpenSheet'}}"{{/if}}>
      {{#if actor}}<img src="{{actor.img}}" alt="">{{else}}<i class="fa-solid fa-wallet"></i>{{/if}}
    </div>
    <div class="nh-hq-title">
      <h1>{{#if actor}}{{actor.name}}{{else}}{{localize "NEONHUB.Lifestyle.Title"}}{{/if}}</h1>
      <p>{{localize "NEONHUB.Lifestyle.Subtitle"}} &middot; {{monthLabel}}{{#if calendarName}} <span class="nh-ls-cal">({{calendarName}})</span>{{/if}}{{#if rentNext}} &middot; <i class="fa-solid fa-house-chimney"></i> {{rentNext}}{{/if}}</p>
    </div>
    {{#if actor}}<span class="nh-status nh-ls-status-{{status}}">{{statusLabel}}</span>{{/if}}
    {{#if characters.length}}
    <select name="actor" class="nh-ls-picker" aria-label="{{localize 'NEONHUB.Lifestyle.PickCharacter'}}">
      {{#unless actor}}<option value="">{{localize "NEONHUB.Lifestyle.PickCharacter"}}</option>{{/unless}}
      {{#each characters}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
    </select>
    {{/if}}
  </header>

  {{#if actor}}
  {{#unless actor.hasWallet}}<div class="nh-hq-warning"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "NEONHUB.Lifestyle.NoWallet"}}</div>{{/unless}}
  <section class="nh-hq-stats">
    <div class="nh-stat nh-stat-ip"><span>{{localize "NEONHUB.Lifestyle.Stat.Monthly"}}</span><strong>{{stats.total}}</strong><small>{{#if paid}}{{localize "NEONHUB.Lifestyle.Stat.PaidThisMonth"}}{{else}}{{#if owed}}<span class="nh-due">{{localize "NEONHUB.Lifestyle.Stat.Owed" n=owed.months total=owed.total}}</span>{{else}}<span class="nh-due">{{localize "NEONHUB.Lifestyle.Stat.DueThisMonth"}}</span>{{/if}}{{/if}}</small></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Stat.Wallet"}}</span><strong>{{wallet}}</strong><small class="{{#if stats.afterNegative}}nh-ls-neg{{/if}}">{{localize "NEONHUB.Lifestyle.Stat.After" after=stats.after}}</small></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Group.housing"}}</span><strong>{{stats.housing}}</strong></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Group.lifestyle"}}</span><strong>{{stats.lifestyleCost}}</strong><small>{{stats.lifestyle}}{{#if stats.discount}} &middot; &minus;{{stats.discount}}{{/if}}</small></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Group.memberships"}}</span><strong>{{stats.memberships}}</strong></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Group.transport"}}</span><strong>{{stats.transport}}</strong></div>
    <div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Group.loans"}}</span><strong>{{stats.loans}}</strong></div>
    {{#if stats.humanity}}<div class="nh-stat"><span>{{localize "NEONHUB.Lifestyle.Stat.Humanity"}}</span><strong>+{{stats.humanity}}</strong><small>{{localize "NEONHUB.Lifestyle.Stat.HumanityHint"}}</small></div>{{/if}}
  </section>

  {{#each hqs}}
  <div class="nh-ls-hq {{#unless active}}is-inactive{{/unless}}">
    <i class="fa-solid fa-house-signal"></i>
    <span>{{localize "NEONHUB.Lifestyle.HQLine" hq=name status=statusLabel}}</span>
    <span>{{#if shareText}}{{localize "NEONHUB.Lifestyle.HQRent" rent=rentText share=shareText}} &middot; {{#if rentPaid}}{{localize "NEONHUB.HQ.Stat.Paid"}}{{else}}<b class="nh-due">{{localize "NEONHUB.HQ.Stat.Due"}}</b>{{/if}}{{else}}{{rentText}}{{/if}}</span>
    {{#if discountText}}<span class="nh-ls-good">{{localize "NEONHUB.Lifestyle.HQDiscount" discount=discountText}}</span>{{/if}}
    <button type="button" data-action="openHQ" data-id="{{id}}"><i class="fa-solid fa-arrow-up-right-from-square"></i> {{localize "NEONHUB.Lifestyle.OpenHQ"}}</button>
  </div>
  {{/each}}
  {{/if}}

  <nav class="nh-tabs" role="tablist">
    {{#if actor}}
    <button type="button" role="tab" class="{{#if tab.current}}active{{/if}}" data-action="view" data-tab="current"><i class="fa-solid fa-wallet"></i> {{localize "NEONHUB.Lifestyle.Tab.current"}}</button>
    <button type="button" role="tab" class="{{#if tab.catalog}}active{{/if}}" data-action="view" data-tab="catalog"><i class="fa-solid fa-store"></i> {{localize "NEONHUB.Lifestyle.Tab.catalog"}}</button>
    <button type="button" role="tab" class="{{#if tab.bills}}active{{/if}}" data-action="view" data-tab="bills"><i class="fa-solid fa-receipt"></i> {{localize "NEONHUB.Lifestyle.Tab.bills"}}</button>
    {{/if}}
    {{#if isGM}}
    <button type="button" role="tab" class="{{#if tab.month}}active{{/if}}" data-action="view" data-tab="month"><i class="fa-solid fa-calendar-days"></i> {{localize "NEONHUB.Lifestyle.Tab.month"}}</button>
    <button type="button" role="tab" class="{{#if tab.households}}active{{/if}}" data-action="view" data-tab="households"><i class="fa-solid fa-people-roof"></i> {{localize "NEONHUB.Household.Tab"}}</button>
    {{#unless actor}}<button type="button" role="tab" class="{{#if tab.catalog}}active{{/if}}" data-action="view" data-tab="catalog"><i class="fa-solid fa-store"></i> {{localize "NEONHUB.Lifestyle.Tab.catalog"}}</button>{{/unless}}
    {{/if}}
    <div class="nh-gm-tools">
      {{#if canPay}}<button type="button" class="nh-cta" data-action="pay"><i class="fa-solid fa-money-bill-wave"></i> {{#if owed}}{{localize "NEONHUB.Lifestyle.PayMonths" n=owed.months amount=payAmount}}{{else}}{{localize "NEONHUB.Lifestyle.PayNow" amount=payAmount}}{{/if}}</button>{{/if}}
      {{#if isGM}}{{#unless tab.month}}{{#if calendarMode}}<button type="button" data-action="openCalendar"><i class="fa-solid fa-calendar-days"></i> {{localize "NEONHUB.Calendar.Title"}}</button>{{else}}<button type="button" data-action="newMonth"><i class="fa-solid fa-calendar-plus"></i> {{localize "NEONHUB.Lifestyle.NewMonth"}}</button>{{/if}}{{/unless}}{{/if}}
    </div>
  </nav>

  {{!-- ================= CURRENT ================= --}}
  {{#if tab.current}}
  <div class="nh-hq-scroll">
    {{#if rules2070}}
    <section class="nh-ls-home {{#if humanityDue}}is-due{{/if}}">
      {{#if home}}
      <div class="nh-ls-home-facts">
        <span class="nh-ls-home-name"><i class="fa-solid fa-house"></i> {{home.name}}</span>
        <span class="{{#if home.over}}nh-ls-neg{{/if}}" data-tooltip="{{localize 'NEONHUB.Lifestyle.Home.SlotsTip'}}"><i class="fa-solid fa-table-cells"></i> {{localize "NEONHUB.Lifestyle.Home.Slots" used=home.used slots=home.slots}}</span>
        <span><i class="fa-solid fa-bed"></i> {{localize "NEONHUB.Lifestyle.Home.Sleeps" n=home.sleeps}}</span>
        <span data-tooltip="{{localize 'NEONHUB.Lifestyle.Home.ArtTip'}}"><i class="fa-solid fa-palette"></i> {{localize "NEONHUB.Lifestyle.Home.Art" n=home.art limit=home.artLimit hg=home.artHumanity}}</span>
        {{#if home.furnishing}}<span><i class="fa-solid fa-couch"></i> {{home.furnishing}}</span>{{/if}}
      </div>
      {{#if home.over}}<p class="nh-ls-home-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "NEONHUB.Lifestyle.Home.Over"}}</p>{{/if}}
      {{#if home.blocked}}<p class="nh-ls-home-warn"><i class="fa-solid fa-triangle-exclamation"></i> {{localize "NEONHUB.Lifestyle.Home.Blocked"}}</p>{{/if}}
      {{#if home.unshown}}<p class="nh-hint">{{localize "NEONHUB.Lifestyle.Home.Unshown" n=home.unshown}}</p>{{/if}}
      {{/if}}
      <div class="nh-ls-home-tools">
        {{#if humanityDue}}<span class="nh-due"><i class="fa-solid fa-heart-pulse"></i> {{localize "NEONHUB.Lifestyle.Humanity.Due"}}</span>{{/if}}
        {{#if canMakeArt}}<button type="button" data-action="makeArt"><i class="fa-solid fa-palette"></i> {{localize "NEONHUB.Lifestyle.Art.Make"}}</button>{{/if}}
        {{#if isGM}}
        <button type="button" class="{{#if humanityDue}}nh-cta{{/if}}" data-action="humanityCheck"><i class="fa-solid fa-heart-pulse"></i> {{localize "NEONHUB.Lifestyle.Humanity.Button"}}</button>
        <button type="button" data-action="incident"><i class="fa-solid fa-heart-crack"></i> {{localize "NEONHUB.Lifestyle.Incident.Button"}}</button>
        {{/if}}
      </div>
    </section>
    {{/if}}
    {{#if reminders.length}}
    <ul class="nh-ls-reminders">{{#each reminders}}<li><i class="fa-solid fa-dice-d20"></i> {{this}}</li>{{/each}}</ul>
    {{/if}}
    {{#each groups}}
    <section class="nh-ls-group">
      <h3><span>{{label}}</span>{{#if total}}<b>{{total}}</b>{{/if}}</h3>
      <div class="nh-ls-grid">
        {{#each cards}}
        <article class="nh-ls-item {{#if active}}is-active{{/if}}" data-item="{{id}}">
          <header>
            <img src="{{img}}" alt="">
            <div>
              <h4>{{name}}</h4>
              <span class="nh-ls-cat"><i class="{{icon}}"></i> {{category}}</span>
            </div>
            {{#if canToggle}}
            <button type="button" class="nh-ls-switch {{#if active}}on{{/if}}" data-action="toggle" role="switch" aria-checked="{{#if active}}true{{else}}false{{/if}}" data-tooltip="{{#if active}}{{localize 'NEONHUB.Lifestyle.Deactivate'}}{{else}}{{localize 'NEONHUB.Lifestyle.Activate'}}{{/if}}">
              <span>{{#if active}}{{localize "NEONHUB.Lifestyle.Active"}}{{else}}{{localize "NEONHUB.Lifestyle.Inactive"}}{{/if}}</span>
            </button>
            {{else}}
            <span class="nh-ls-switch static {{#if active}}on{{/if}}"><span>{{#if active}}{{localize "NEONHUB.Lifestyle.Active"}}{{else}}{{localize "NEONHUB.Lifestyle.Inactive"}}{{/if}}</span></span>
            {{/if}}
          </header>
          <p class="nh-ls-cost">{{costText}}</p>
          {{#if badges.length}}<ul class="nh-ls-badges">{{#each badges}}<li class="{{#if warn}}warn{{/if}}"><i class="{{icon}}"></i> {{text}}</li>{{/each}}</ul>{{/if}}
          {{#if effects}}<p class="nh-ls-effects"><i class="fa-solid fa-bolt"></i> {{effects}}</p>{{/if}}
          {{#if household}}
          <p class="nh-ls-desc"><i class="fa-solid fa-users"></i> {{description}}</p>
          {{#if household.pool}}
          <ul class="nh-hh-pool">{{#each household.pool}}<li><span>{{name}}</span><b>{{amount}}</b></li>{{/each}}</ul>
          <p class="nh-hint">{{#if household.covered}}<i class="fa-solid fa-circle-check"></i> {{localize "NEONHUB.Household.Covered"}}{{else}}{{localize "NEONHUB.Household.Left" left=household.left}}{{/if}}</p>
          {{/if}}
          {{else}}
          {{#if description}}<p class="nh-ls-desc">{{description}}</p>{{/if}}
          {{/if}}
          <footer {{#if household}}data-household="{{household.id}}"{{/if}}>
            {{#if household.canChip}}<button type="button" class="nh-cta" data-action="chipIn"><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "NEONHUB.Household.ChipIn.Button"}}</button>{{/if}}
            {{#if household.isGM}}<button type="button" data-action="view" data-tab="households"><i class="fa-solid fa-people-roof"></i> {{localize "NEONHUB.Household.Manage"}}</button>{{/if}}
            {{#if showAmount}}
            <label class="nh-ls-amount">{{localize "NEONHUB.Lifestyle.Quantity"}} <input type="number" min="1" value="{{amount}}" data-amount="{{id}}" {{#unless canAmount}}disabled{{/unless}}></label>
            {{/if}}
            {{#if canCall}}<button type="button" data-action="call"><i class="fa-solid {{callIcon}}"></i> {{localize "NEONHUB.Lifestyle.Call"}}</button>{{/if}}
            {{#if buyHome}}<button type="button" data-action="buyHome"><i class="fa-solid fa-key"></i> {{localize "NEONHUB.Lifestyle.BuyHome" amount=buyHome}}</button>{{/if}}
            {{#if payoff}}<button type="button" data-action="payoff"><i class="fa-solid fa-hand-holding-dollar"></i> {{localize "NEONHUB.Lifestyle.Payoff" amount=payoff}}</button>{{/if}}
            <span class="nh-ls-spacer"></span>
            {{#if canOpen}}<button type="button" class="nh-icon-btn" data-action="openItem" aria-label="{{localize 'NEONHUB.Lifestyle.OpenItem'}}" data-tooltip="{{localize 'NEONHUB.Lifestyle.OpenItem'}}"><i class="fa-solid fa-file-lines"></i></button>{{/if}}
            {{#if canConfig}}<button type="button" class="nh-icon-btn" data-action="configItem" aria-label="{{localize 'NEONHUB.Lifestyle.Configure'}}" data-tooltip="{{localize 'NEONHUB.Lifestyle.Configure'}}"><i class="fa-solid fa-sliders"></i></button>{{/if}}
            {{#if canRemove}}<button type="button" class="nh-icon-btn" data-action="remove" aria-label="{{localize 'NEONHUB.Lifestyle.Remove'}}" data-tooltip="{{localize 'NEONHUB.Lifestyle.Remove'}}"><i class="fa-solid fa-trash"></i></button>{{/if}}
          </footer>
        </article>
        {{/each}}
      </div>
    </section>
    {{/each}}
    {{#if empty}}
    <div class="nh-ls-empty">
      <i class="fa-solid fa-person-shelter"></i>
      <p>{{localize "NEONHUB.Lifestyle.Empty"}}</p>
      <button type="button" class="nh-cta" data-action="view" data-tab="catalog"><i class="fa-solid fa-store"></i> {{localize "NEONHUB.Lifestyle.BrowseCatalog"}}</button>
    </div>
    {{/if}}
  </div>
  {{/if}}

  {{!-- ================= CATALOG ================= --}}
  {{#if tab.catalog}}
  <div class="nh-ls-toolbar">
    <div class="nh-ls-filters">
      {{#each catalog.filters}}<button type="button" class="{{#if active}}active{{/if}}" data-action="filter" data-filter="{{key}}">{{#if icon}}<i class="{{icon}}"></i> {{/if}}{{label}}</button>{{/each}}
    </div>
    <input type="search" name="search" value="{{catalog.search}}" placeholder="{{localize 'NEONHUB.Lifestyle.Search'}}" aria-label="{{localize 'NEONHUB.Lifestyle.Search'}}">
    {{#if isGM}}<button type="button" data-action="newHomebrew"><i class="fa-solid fa-flask"></i> {{localize "NEONHUB.Lifestyle.NewHomebrew"}}</button>{{/if}}
  </div>
  <div class="nh-hq-scroll">
    {{#if catalog.packMissing}}<p class="nh-hq-warning">{{localize "NEONHUB.Lifestyle.PackMissing"}}</p>{{/if}}
    {{#unless actor}}<p class="nh-hint nh-ls-pickhint">{{localize "NEONHUB.Lifestyle.PickToAdd"}}</p>{{/unless}}
    <p class="nh-hint nh-ls-era"><i class="fa-solid fa-clock-rotate-left"></i> {{localize "NEONHUB.Lifestyle.CatalogEra" era=catalog.era}}</p>
    <div class="nh-ls-grid">
      {{#each catalog.entries}}
      <article class="nh-ls-item nh-ls-offer {{#if owned}}is-owned{{/if}}" data-uuid="{{uuid}}" data-search="{{search}}">
        <header>
          <img src="{{img}}" alt="">
          <div>
            <h4>{{name}}</h4>
            <span class="nh-ls-cat"><i class="{{icon}}"></i> {{category}}{{#if world}} &middot; {{localize "NEONHUB.Lifestyle.Homebrew"}}{{/if}}</span>
          </div>
          {{#if owned}}<span class="nh-ls-owned">{{localize "NEONHUB.Lifestyle.Owned"}}</span>{{/if}}
        </header>
        <p class="nh-ls-cost">{{costText}}</p>
        {{#if badges.length}}<ul class="nh-ls-badges">{{#each badges}}<li class="{{#if warn}}warn{{/if}}"><i class="{{icon}}"></i> {{text}}</li>{{/each}}</ul>{{/if}}
        {{#if effects}}<p class="nh-ls-effects"><i class="fa-solid fa-bolt"></i> {{effects}}</p>{{/if}}
        {{#if description}}<p class="nh-ls-desc">{{description}}</p>{{/if}}
        <footer>
          {{#if template}}
          <button type="button" class="nh-cta" data-action="copyTemplate"><i class="fa-solid fa-clone"></i> {{localize "NEONHUB.Lifestyle.UseTemplate"}}</button>
          {{else}}
          {{#if canAdd}}<button type="button" class="nh-cta" data-action="add" {{#if startsLater}}data-tooltip="{{localize 'NEONHUB.Lifestyle.Add.StartsLater'}}"{{/if}}><i class="fa-solid {{#if startsLater}}fa-hourglass-half{{else}}fa-plus{{/if}}"></i> {{addLabel}}</button>{{/if}}
          {{#if ../isGM}}<button type="button" class="nh-icon-btn" data-action="copyTemplate" aria-label="{{localize 'NEONHUB.Lifestyle.CopyToWorld'}}" data-tooltip="{{localize 'NEONHUB.Lifestyle.CopyToWorld'}}"><i class="fa-solid fa-copy"></i></button>{{/if}}
          {{/if}}
        </footer>
      </article>
      {{/each}}
    </div>
    <p class="nh-hint nh-ls-noresults" {{#if catalog.entries.length}}hidden{{/if}}>{{localize "NEONHUB.Lifestyle.NoResults"}}</p>
  </div>
  {{/if}}

  {{!-- ================= BILLS ================= --}}
  {{#if tab.bills}}
  <div class="nh-hq-scroll">
    <ul class="nh-ls-history">
      {{#each history}}
      <li>
        <details>
          <summary>
            <span class="nh-ls-hlabel">{{label}}</span>
            <time>{{date}}</time>
            <b>&minus;{{total}}</b>
            <span class="{{#if debt}}nh-ls-neg{{/if}}">{{localize "NEONHUB.Lifestyle.Chat.Balance"}} {{after}}</span>
          </summary>
          <ul>
            {{#each lines}}<li><span>{{name}}</span><span>{{cost}}</span></li>{{/each}}
            {{#if discount}}<li class="nh-ls-good"><span>{{localize "NEONHUB.Lifestyle.MoraleDiscount"}}</span><span>&minus;{{discount}}</span></li>{{/if}}
          </ul>
          <small>{{localize "NEONHUB.Lifestyle.PaidBy" user=user}}</small>
        </details>
      </li>
      {{else}}
      <li class="nh-hint">{{localize "NEONHUB.Lifestyle.NoBills"}}</li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  {{!-- ================= HOUSEHOLDS (GM) ================= --}}
  {{#if tab.households}}
  <div class="nh-hq-scroll">
    <div class="nh-ls-monthbar">
      <div>
        <h2>{{localize "NEONHUB.Household.Tab"}}</h2>
        <p class="nh-hint">{{localize "NEONHUB.Household.Intro"}}</p>
      </div>
      <button type="button" class="nh-cta" data-action="newHousehold"><i class="fa-solid fa-plus"></i> {{localize "NEONHUB.Household.New"}}</button>
    </div>
    <div class="nh-ls-grid">
      {{#each householdList}}
      <article class="nh-ls-item is-active nh-hh-card" data-household="{{id}}">
        <header>
          <img src="{{img}}" alt="">
          <div>
            <h4>{{name}}</h4>
            <span class="nh-ls-cat"><i class="fa-solid fa-people-roof"></i> {{mode}}{{#if payer}}: {{payer}}{{/if}}</span>
          </div>
        </header>
        <p class="nh-ls-cost">{{localize "NEONHUB.Household.RentLine" rent=rent}}</p>
        <ul class="nh-ls-badges">
          <li class="{{#if over}}warn{{/if}}"><i class="fa-solid fa-bed"></i> {{localize "NEONHUB.Household.Badge.Living" n=living sleeps=sleeps}}</li>
          <li class="{{#if overSlots}}warn{{/if}}"><i class="fa-solid fa-table-cells"></i> {{localize "NEONHUB.Lifestyle.Home.Slots" used=used slots=slots}}</li>
        </ul>
        <ul class="nh-hh-people">
          {{#each people}}<li><img src="{{img}}" alt=""><span>{{name}}</span><b>{{share}}</b></li>{{else}}<li class="nh-hint">{{localize "NEONHUB.Household.Empty"}}</li>{{/each}}
        </ul>
        {{#if pool}}
        <div class="nh-hh-bar {{#if pool.covered}}is-covered{{/if}}"><span style="width: {{pool.pct}}%"></span></div>
        <p class="nh-hint">{{localize "NEONHUB.Household.PoolLine" total=pool.total rent=pool.rent}}</p>
        {{/if}}
        <footer>
          <span class="nh-ls-spacer"></span>
          <button type="button" class="nh-icon-btn" data-action="editHousehold" aria-label="{{localize 'NEONHUB.Household.Edit'}}" data-tooltip="{{localize 'NEONHUB.Household.Edit'}}"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="nh-icon-btn" data-action="deleteHousehold" aria-label="{{localize 'NEONHUB.Household.Delete'}}" data-tooltip="{{localize 'NEONHUB.Household.Delete'}}"><i class="fa-solid fa-trash"></i></button>
        </footer>
      </article>
      {{else}}
      <p class="nh-hint">{{localize "NEONHUB.Household.None"}}</p>
      {{/each}}
    </div>
  </div>
  {{/if}}

  {{!-- ================= MONTH (GM) ================= --}}
  {{#if tab.month}}
  <div class="nh-hq-scroll">
    <div class="nh-ls-monthbar">
      <div>
        <h2>{{monthLabel}}</h2>
        <p class="nh-hint">{{localize "NEONHUB.Lifestyle.DueCount" n=overview.due}}{{#if overview.rules2070}} &middot; {{localize "NEONHUB.Lifestyle.Humanity.DueCount" n=overview.humanityDue}}{{/if}} &middot; {{overview.era}}</p>
      </div>
      {{#if overview.rules2070}}<button type="button" data-action="incident"><i class="fa-solid fa-heart-crack"></i> {{localize "NEONHUB.Lifestyle.Incident.Button"}}</button>{{/if}}
      <button type="button" data-action="billAll" {{#unless overview.due}}disabled{{/unless}}><i class="fa-solid fa-file-invoice-dollar"></i> {{localize "NEONHUB.Lifestyle.BillAll"}}</button>
      {{#if overview.calendarMode}}
      <button type="button" class="nh-cta" data-action="openCalendar"><i class="fa-solid fa-calendar-days"></i> {{localize "NEONHUB.Calendar.Title"}}</button>
      {{else}}
      <button type="button" class="nh-cta" data-action="newMonth"><i class="fa-solid fa-calendar-plus"></i> {{localize "NEONHUB.Lifestyle.NewMonth"}}</button>
      {{/if}}
    </div>
    {{#if overview.calendarMode}}
    <div class="nh-ls-calendars">
      {{#each overview.calendars}}
      <div class="nh-ls-calrow" data-calendar="{{id}}" style="--cal: {{color}}">
        <i class="nh-ls-caldot"></i>
        <b>{{name}}</b>
        <span>{{date}}</span>
        <span class="nh-hint">{{localize "NEONHUB.Lifestyle.RentMonth" month=label}}</span>
        <span class="nh-ls-calrent"><i class="fa-solid fa-house-chimney"></i> {{rent}}</span>
        <button type="button" data-action="toRentDay" data-tooltip="{{localize 'NEONHUB.Calendar.Rent.GoTip'}}"><i class="fa-solid fa-forward-step"></i> {{localize "NEONHUB.Calendar.Rent.Go"}}</button>
      </div>
      {{/each}}
      <p class="nh-hint">{{#if overview.autoBill}}{{localize "NEONHUB.Lifestyle.AutoBillOn"}}{{else}}{{localize "NEONHUB.Lifestyle.AutoBillOff"}}{{/if}}</p>
    </div>
    {{/if}}
    <table class="nh-ls-table">
      <thead><tr><th>{{localize "NEONHUB.Lifestyle.Col.Character"}}</th>{{#if overview.calendarMode}}<th>{{localize "NEONHUB.Lifestyle.Col.Calendar"}}</th>{{/if}}<th>{{localize "NEONHUB.Lifestyle.Col.Wallet"}}</th><th>{{localize "NEONHUB.Lifestyle.Col.Monthly"}}</th><th>{{localize "NEONHUB.Lifestyle.Col.Status"}}</th>{{#if overview.rules2070}}<th>{{localize "NEONHUB.Lifestyle.Col.Humanity"}}</th>{{/if}}<th></th></tr></thead>
      <tbody>
        {{#each overview.rows}}
        <tr data-actor="{{id}}" class="{{#if selected}}selected{{/if}}">
          <td><a data-action="viewActor"><img src="{{img}}" alt=""> <span><b>{{name}}</b><small>{{owners}}</small></span></a></td>
          {{#if ../overview.calendarMode}}<td>{{#if calendar}}<span class="nh-ls-calname" style="--cal: {{calendar.color}}"><i class="nh-ls-caldot"></i> {{calendar.name}}</span>{{/if}}</td>{{/if}}
          <td class="{{#if negative}}nh-ls-neg{{/if}}">{{wallet}}</td>
          <td>{{total}}{{#if owed}}<br><small class="nh-due">{{owed}}</small>{{/if}}</td>
          <td><span class="nh-ls-pill nh-ls-status-{{status}}">{{statusLabel}}</span></td>
          {{#if ../overview.rules2070}}<td><button type="button" class="{{#if humanityDue}}nh-cta{{/if}}" data-action="humanityCheck" data-tooltip="{{localize 'NEONHUB.Lifestyle.Humanity.Button'}}"><i class="fa-solid fa-heart-pulse"></i> {{#if humanityDue}}{{localize "NEONHUB.Lifestyle.Humanity.DueShort"}}{{else}}{{localize "NEONHUB.Lifestyle.Humanity.Roll"}}{{/if}}</button></td>{{/if}}
          <td class="nh-ls-rowtools">
            {{#if paid}}
            <button type="button" data-action="markPaid" data-paid="false" data-tooltip="{{localize 'NEONHUB.Lifestyle.MarkDueTip'}}"><i class="fa-solid fa-rotate-left"></i> {{localize "NEONHUB.Lifestyle.MarkDue"}}</button>
            {{else}}
            <button type="button" data-action="payFor"><i class="fa-solid fa-money-bill-wave"></i> {{localize "NEONHUB.Lifestyle.Charge"}}</button>
            <button type="button" data-action="markPaid" data-paid="true" data-tooltip="{{localize 'NEONHUB.Lifestyle.MarkPaidTip'}}"><i class="fa-solid fa-check"></i></button>
            {{/if}}
          </td>
        </tr>
        {{else}}
        <tr><td colspan="7" class="nh-hint">{{localize "NEONHUB.Lifestyle.NoCharacters"}}</td></tr>
        {{/each}}
      </tbody>
    </table>
    <div class="nh-ls-settings">
      <label>{{localize "NEONHUB.HQ.Field.theme"}}
        <select name="theme">{{#each overview.themes}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
      </label>
      <p class="nh-hint">
        <i class="fa-solid fa-gear"></i>
        {{#if overview.manage}}{{localize "NEONHUB.Lifestyle.ManageOn"}}{{else}}{{localize "NEONHUB.Lifestyle.ManageOff"}}{{/if}}
        {{#if overview.debt}}{{localize "NEONHUB.Lifestyle.DebtOn"}}{{else}}{{localize "NEONHUB.Lifestyle.DebtOff"}}{{/if}}
        {{localize "NEONHUB.Lifestyle.SettingsWhere"}}
      </p>
    </div>
  </div>
  {{/if}}
</div>
