{
  "id": "cpr-neon-hub",
  "title": "Neon Hub: Landing Pages, Headquarters, Lifestyle, Calendar & Journal for Cyberpunk RED",
  "description": "Build clickable landing-page hub scenes with Monk's Active Tile Triggers, run crew Headquarters from the No Place Like Home rules, track each character's rent, lifestyle and monthly expenses, and keep group calendars with rent days and the real Moon, for the Cyberpunk RED - CORE system, and run the Neon Journal: gigs with pay-outs, screamsheets, worldbuilding, character journals, the story and a downtime log.",
  "version": "1.12.2",
  "authors": [
    {
      "name": "Neon Hub contributors"
    }
  ],
  "compatibility": {
    "minimum": "12",
    "verified": "12"
  },
  "relationships": {
    "systems": [
      {
        "id": "cyberpunk-red-core",
        "type": "system",
        "compatibility": {
          "minimum": "0.92",
          "verified": "0.92.4"
        }
      }
    ],
    "requires": [
      {
        "id": "monks-active-tiles",
        "type": "module",
        "compatibility": {
          "minimum": "12.02"
        }
      }
    ],
    "recommends": [
      {
        "id": "cpr-neon-market",
        "type": "module",
        "reason": "Lets hub buttons open Neon Market shops."
      },
      {
        "id": "night-city-messenger",
        "type": "module",
        "reason": "Lets hub buttons open the Agent inbox, contacts and the messenger's GM tools."
      },
      {
        "id": "smalltime",
        "type": "module",
        "reason": "Calendars move on a day when its clock passes midnight, and the calendar window gets its time controls. Use SmallTime 1.24.0 on Foundry v12.",
        "compatibility": {
          "minimum": "1.24.0"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/neon-hub.css",
    "styles/calendar.css",
    "styles/journal.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "lifestyle",
      "label": "Neon Hub: Lifestyle (2045)",
      "path": "packs/lifestyle",
      "type": "Item",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "lifestyle-2070",
      "label": "Neon Hub: Lifestyle (2070s)",
      "path": "packs/lifestyle-2070",
      "type": "Item",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "street-goods",
      "label": "Neon Hub: Street Goods & Lifepath",
      "path": "packs/street-goods",
      "type": "Item",
      "system": "cyberpunk-red-core",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "screamsheet-tables",
      "label": "Neon Hub: Screamsheet Tables",
      "path": "packs/screamsheet-tables",
      "type": "RollTable",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    },
    {
      "name": "worldbook-2070",
      "label": "Neon Hub: Worldbook (2070s)",
      "path": "packs/worldbook-2070",
      "type": "JournalEntry",
      "ownership": {
        "PLAYER": "NONE",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "Neon Hub",
      "sorting": "m",
      "color": "#ff2a6d",
      "packs": [
        "lifestyle",
        "lifestyle-2070",
        "street-goods",
        "screamsheet-tables",
        "worldbook-2070"
      ]
    }
  ],
  "socket": true,
  "url": "",
